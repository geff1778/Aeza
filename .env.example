# ============================================================================
# Invoice Keeper — пример конфигурации окружения.
# Скопируйте файл в .env и заполните значения. НЕ коммитьте реальный .env.
#   cp .env.example .env
# ============================================================================

# --- Основное ---
APP_ENV=development
APP_TIMEZONE=Europe/Moscow
APP_NAME=Invoice Keeper
# Публичный адрес приложения (используется в ссылках и настройках cookie)
APP_PUBLIC_URL=http://localhost:8080

# --- База данных ---
# Внутри Docker Compose используется имя сервиса postgres как хост.
DATABASE_URL=postgresql+psycopg://invoice:invoice@postgres:5432/invoice

# --- Секреты ---
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Bootstrap администратора ---
# Создаётся при первом запуске. Пароль хешируется, повторный запуск не перезаписывает его.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- Сессии и cookie ---
SESSION_COOKIE_NAME=invoice_session
SESSION_TTL_HOURS=168
# Secure=true обязателен в production (работает только по HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ---
# Список источников через запятую. Пусто = только same-origin (рекомендуется).
# Пусто = только same-origin (рекомендуется при работе через reverse proxy).
CORS_ORIGINS=

# --- Защита от подбора пароля ---
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Напоминания и worker ---
REMINDER_DAYS_BEFORE=3
GENERATION_HORIZON_MONTHS=12
# Как часто worker проверяет периоды и отправляет напоминания
WORKER_INTERVAL_SECONDS=60
# После скольких неудачных попыток уведомление помечается как окончательно неудачное.
# Задержка между попытками растёт автоматически (экспоненциально).
WORKER_MAX_ATTEMPTS=5

# --- Telegram ---
# Получите токен у @BotFather. Оставьте пустым, чтобы отключить интеграцию.
# Приложение продолжит работать без Telegram.
TELEGRAM_BOT_TOKEN=
# ID чата или канала для уведомлений (узнать можно через @userinfobot)
TELEGRAM_CHAT_ID=
# Необязательно: список Telegram user id, которым разрешено нажимать «Оплачено».
# Пусто = разрешено всем участникам чата.
TELEGRAM_ALLOWED_USER_IDS=

# --- Email (SMTP) ---
# Необязательный канал. Пустой SMTP_HOST отключает отправку письма.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Список получателей через запятую
SMTP_TO=
SMTP_USE_TLS=true

# --- Демонстрационные данные (только для локального демо) ---
# Используются скриптом scripts/seed_demo.py. Замените пароль на демонстрационном стенде.
DEMO_USERNAME=demo_user
DEMO_PASSWORD=DemoUser123!
DEMO_EMAIL=demo_user@example.com

# --- Загрузка чеков ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
